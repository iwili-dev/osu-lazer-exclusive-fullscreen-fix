<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>osu-lazer-fix</AssemblyName>
    <RootNamespace>OsuLazerFix</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The program compares this with "app.version" in update/manifest.json. Raise it for every new exe. -->
    <Version>1.0.0</Version>
    <Product>osu!lazer Fix</Product>
    <Company>iwili</Company>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- Everything inside the payload folder is embedded into the exe. Layout:
       payload/<game version>/patch.ini
       payload/<game version>/online/ppy.Veldrid.dll
       payload/<game version>/partial-offline/ppy.Veldrid.dll
       payload/<game version>/partial-offline/osu.Framework.dll -->
  <ItemGroup>
    <EmbeddedResource Include="payload\**\*" LogicalName="payload/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
